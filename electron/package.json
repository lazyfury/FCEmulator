{
  "name": "fc-emulator",
  "private": true,
  "version": "0.1.0",
  "description": "NES / FC emulator - Electron front end. The emulator itself is in ../src, compiled to WebAssembly.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "wasm": "bash ../wasm/build.sh",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:gamepad": "node scripts/dev.mjs --gamepad",
    "start": "pnpm run build && electron .",
    "selftest": "pnpm run build && electron . --selftest 300 --dump selftest.png",
    "keytest": "pnpm run build && electron . --keytest",
    "audiotest": "pnpm run build && electron . --audiotest 8",
    "gamepad": "pnpm run build && electron . --gamepad"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.45.0"
  }
}
