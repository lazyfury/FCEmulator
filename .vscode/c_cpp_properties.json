{
    "version": 4,
    "configurations": [
        {
            "name": "ClassicGameBox",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "cppStandard": "c++20",
            "cStandard": "c17",
            "intelliSenseMode": "macos-clang-arm64",
            "compilerPath": "/usr/bin/clang++",
            "includePath": [
                "${workspaceFolder}/src/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/tests",
                    "${workspaceFolder}/tools"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
