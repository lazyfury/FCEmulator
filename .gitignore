# Build output
build/
cmake-build-*/

# macOS
.DS_Store
._*

# Editors
# Ignore the whole folder, but keep the shared project configuration so a
# fresh clone gets a working IntelliSense setup (C++20, compile_commands.json).
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Apple / Xcode (future frontend)
*.xcuserstate
xcuserdata/
DerivedData/

# Real ROMs are never committed (copyright, and they are big)
*.nes
tests/data/
