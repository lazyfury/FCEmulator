# Build output
build/
cmake-build-*/

# macOS
.DS_Store
._*

# Editors
# Ignore the whole folder, but keep the shared project configuration so a
# fresh clone gets a working IntelliSense setup (C++20, compile_commands.json).
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Apple / Xcode
*.xcuserstate
xcuserdata/
DerivedData/

# Real ROMs are never committed (copyright, and they are big)
*.nes
tests/data/

# Demo output: PPM pictures and WAV files the teaching demos write. Generated
# by `./build/demo_ppu`, `./build/demo_input` and `./build/demo_apu`; the README
# tells you to run those before looking at them.
frames/

# Emscripten SDK. Installed by wasm/build.sh's instructions; about 1.4GB, and
# it is a toolchain, not a source file.
third_party/emsdk/

# WebAssembly build output
build-wasm/
wasm/dist/

# Test ROMs. Copyrighted, large, and not ours to commit. See the README for
# where to get them; the tests skip themselves when the folder is empty.
tests/data/testroms/
